    const labels = {
        "postproc-q": [qsTr("Off"), "1", "2", "3", "4", "5", "6"],
        "aspect-ratio": [qsTr("Automatic")],
        "sub-autodetect-fuzzy": [qsTr("Exact title"), qsTr("Title with extra characters"), qsTr("Title anywhere in the name"), qsTr("Any subtitle in the folder")]
